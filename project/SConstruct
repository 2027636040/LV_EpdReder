import os
import sys
import rtconfig

# Check SDK 
SIFLI_SDK = os.getenv('SIFLI_SDK')
if not SIFLI_SDK:
    print("Please run set_env.bat in root folder of SIFLI SDK to set environment.")
    exit()
from building import *

# Prepare environment.
PrepareEnv()

################################## change rtconfig.xxx to customize build ########################################

# Add bootloader project
AddBootLoader(SIFLI_SDK,rtconfig.CHIP)

# Add LCPU project
AddLCPU(SIFLI_SDK,rtconfig.CHIP,"../../src/lcpu_img.c")
# Set default compile options
SifliEnv()
# NOR metadata wear levelling; the SDK port otherwise defaults to disabled (-1).
rtconfig.CFLAGS += ' -DLFS_BLOCK_CYCLES=500'

TARGET = rtconfig.OUTPUT_DIR + rtconfig.TARGET_NAME + '.' + rtconfig.TARGET_EXT
env = Environment(tools = ['mingw'],
    AS = rtconfig.AS, ASFLAGS = rtconfig.AFLAGS,
    CC = rtconfig.CC, CFLAGS = rtconfig.CFLAGS,
    CXX = rtconfig.CXX, CXXFLAGS = rtconfig.CXXFLAGS,
    AR = rtconfig.AR, ARFLAGS = '-rc',
    LINK = rtconfig.LINK, LINKFLAGS = rtconfig.LFLAGS)
env.PrependENVPath('PATH', rtconfig.EXEC_PATH)
if ARGUMENTS.get('HANG_DIAG') == '1':
    env.Append(CPPDEFINES=['EPD_HANG_DIAG'])
   
# Prepare building environment
objs = PrepareBuilding(env)

# Build application.
DoBuilding(TARGET, objs)

# Capture the main firmware groups before AddFTAB changes the SDK build context.
import building
from ua import PrepareUA
PrepareUA(building.Projects, os.path.join(SIFLI_SDK, 'rtos/rtthread'), Dir('#').abspath)
# Keep module include paths with the firmware they describe.
import shutil
shutil.copyfile('rtua.py', os.path.join(env['build_dir'], 'rtua.py'))

# Configuration macros can change public structure layouts, so every compiled
# object must depend on rtconfig.h even when it is included through a macro.
config_header = env.File(os.path.join(rtconfig.OUTPUT_DIR, 'rtconfig.h'))
pending_nodes = list(env['target'])
visited_nodes = set()
while pending_nodes:
    node = pending_nodes.pop()
    if node in visited_nodes or not node.has_builder():
        continue
    visited_nodes.add(node)
    if os.path.splitext(str(node))[1] in ('.o', '.obj'):
        env.Depends(node, config_header)
    pending_nodes.extend(node.sources)

# Add flash table
AddFTAB(SIFLI_SDK,rtconfig.CHIP)


# Optional application packages and factory filesystem composition.
sys.path.insert(0, os.path.abspath('../tools'))
from native_apps import select_apps, add_selected_packages
apps = select_apps(ARGUMENTS.get('APPS', ''))
preinstall = select_apps(ARGUMENTS.get('PREINSTALL', ''))
env['APP_NM'] = os.path.join(rtconfig.EXEC_PATH, 'arm-none-eabi-nm.exe')
env['APP_JOBS'] = GetOption('num_jobs')
packages = add_selected_packages(env, SIFLI_SDK, '..', list(dict.fromkeys(apps + preinstall)),
                                dictionary=ARGUMENTS.get('WORDS_DICTIONARY'))
from lfs_image import add_image
fs_bin = add_image(env, SIFLI_SDK, ARGUMENTS.get('STORAGE_IMPORT'),
                   [packages[name] for name in preinstall])
# Always build the image; downloading it remains an explicit initialization step.
if ARGUMENTS.get('STORAGE_IMAGE') == '1' or ARGUMENTS.get('STORAGE_IMPORT'):
    AddCustomImg('fs_root', bin=[fs_bin])
if ARGUMENTS.get('STORAGE_IMPORT'):
    AddCustomImg('ble_store', bin=[os.path.join(os.path.abspath(ARGUMENTS['STORAGE_IMPORT']), 'ble.bin')])


# Add EPD wave form image bin（波形随屏驱存放在 SDK 内）
if GetDepend('EPD_WAVEFORM_USE_BIN'):
    epd_wave_bin=os.path.join(SIFLI_SDK,
        "customer/peripherals/display/epd_e0470a03/waveform/epd_waveform.bin")
    AddCustomImg("wave_table",bin=[epd_wave_bin])

# Generate download .bat script
GenDownloadScript(env)
for name in ('download.bat', 'download.jlink', 'download.sh', 'uart_download.bat', 'uart_download.sh'):
    env.Depends(os.path.join(env['build_dir'], name),
                Value(str((ARGUMENTS.get('STORAGE_IMAGE'), ARGUMENTS.get('STORAGE_IMPORT')))))
