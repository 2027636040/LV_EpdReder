from building import *
from SCons.Script import Dir
import os
import runpy

cwd = GetCurrentDir()
books = os.path.abspath(os.path.join(cwd, '..', '..', 'books'))
formats = os.path.join(books, 'formats')
listing = runpy.run_path(os.path.join(formats, 'sources.py'))
env = GetCurrentEnv().Clone()
env.Append(CPPPATH=[cwd] + listing['include_paths'](formats),
           CPPDEFINES=['BUILD_DLMODULE', 'HAVE_CCONFIG_H', 'LIBXML_STATIC', 'BOOK_FORMAT_TARGET'],
           CCFLAGS=' -O2 -ffunction-sections -fdata-sections')
vendor_env = env.Clone()
vendor_env.Append(CCFLAGS=' -Wno-error -fvisibility=hidden')
sources = [os.path.join(cwd, name) for name in
           ('reader_view.c', 'reader_font.c', 'reader_source.c', 'reader_stream.c')]
sources += [os.path.join(books, 'document', name) for name in
            ('document.c', 'document_cache.c', 'document_image.c')]
sources += [os.path.join(books, 'image', 'book_image.c')]
sources += [p for p in listing['source_files'](formats)
            if os.path.basename(p) != 'book_stream.c']
objects = []
for source in sources:
    vendor = 'third_party' in source
    target = ('vendor_' if vendor else '') + os.path.basename(source).replace('.c', '.o')
    objects += (vendor_env if vendor else env).Object(target, source)
objects += SConscript(os.path.join(cwd, '..', 'image', 'SConscript'),
                      variant_dir=os.path.join(Dir('.').abspath, 'image'), duplicate=0)
Return('objects')
