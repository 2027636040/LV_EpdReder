from building import *
import os

cwd = GetCurrentDir()
GetCurrentEnv().Append(CCFLAGS=' -O2 -ffunction-sections -fdata-sections',
    LINKFLAGS=' -Wl,--gc-sections -Wl,-Bsymbolic -Wl,-u,epd_app_build_id -Wl,--version-script=' +
              os.path.join(cwd, 'exports.map'))
objects = DefineGroup('books', Glob('*.c'), depend=[''],
                      CPPPATH=[cwd], CPPDEFINES=['BUILD_DLMODULE', 'HAVE_CCONFIG_H'])
objects += DefineGroup('book_document', Glob('document/document_view.c'), depend=[''], CPPPATH=[cwd])
objects += SConscript(os.path.join(cwd, '..', 'common', 'reader', 'SConscript'),
                      variant_dir=os.path.join(cwd, 'output', 'reader'), duplicate=0)
Return('objects')
