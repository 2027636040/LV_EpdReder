+rt_err_t mmcsd_change_request(struct rt_mmcsd_host *host)
+{
+    rt_base_t level;
+    rt_err_t err;
+    mmcsd_change_state_t previous;
+
+    if (host == RT_NULL)
+    {
+        return -RT_EINVAL;
+    }
+
+    level = rt_hw_interrupt_disable();
+    previous = host->change_state;
+    if (previous == MMCSD_CHANGE_PENDING)
+    {
+        rt_hw_interrupt_enable(level);
+        return -RT_EBUSY;
+    }
+    host->change_state = MMCSD_CHANGE_PENDING;
+    rt_hw_interrupt_enable(level);
+
+    /* Sending may wake and run the detector before this call returns. */
+    err = rt_mb_send(&mmcsd_detect_mb, (rt_uint32_t)host);
+    if (err != RT_EOK)
+    {
+        level = rt_hw_interrupt_disable();
+        host->change_state = previous;
+        rt_hw_interrupt_enable(level);
+    }
+    return err;
+}
+
+mmcsd_change_state_t mmcsd_change_state_get(struct rt_mmcsd_host *host)
+{
+    rt_base_t level;
+    mmcsd_change_state_t state;
+
+    RT_ASSERT(host != RT_NULL);
+    level = rt_hw_interrupt_disable();
+    state = host->change_state;
+    rt_hw_interrupt_enable(level);
+    return state;
+}
