from pathlib import Path
import importlib.util
import sys
from SCons.Script import ARGUMENTS
from ua import BuildLibrary
import rtconfig

repo = Path(Dir('#').abspath).parents[2]
project = repo / 'project'
firmware = project / ARGUMENTS.get('FIRMWARE', 'build_dpi-hdk_lb57gyd7n6_epd_hcpu')
spec = importlib.util.spec_from_file_location('rtua', firmware / 'rtua.py')
firmware_ua = importlib.util.module_from_spec(spec)
spec.loader.exec_module(firmware_ua)
firmware_paths = firmware_ua.GetCPPPATH

def module_paths(bsp_root, rtt_root):
    paths = [str(firmware)] + firmware_paths(str(project), rtt_root)
    paths += [str(repo / 'SiFli-SDK' / path.split('/sifli_sdk/', 1)[1])
              for path in paths if '/sifli_sdk/' in path]
    return paths

firmware_ua.GetCPPPATH = module_paths
sys.modules['rtua'] = firmware_ua
name = 'diaglib' if ARGUMENTS.get('PRIVATE') == '1' else 'diagmod'
BuildLibrary(name + '.so', 'SConscript', name, BSP_ROOT=str(firmware),
             RTT_ROOT=str(repo / 'SiFli-SDK/rtos/rtthread'))
if name == 'diagmod':
    # This fixture also exercises dlmodule_exec, unlike GUI shared libraries.
    from ua import Env
    Env.Append(LINKFLAGS=' -Wl,-e,main')
